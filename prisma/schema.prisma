generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id                String                @id @default(cuid())
  name              String
  email             String?               @unique
  phone             String?
  preferredLanguage String                @default("en")
  createdAt         DateTime              @default(now())
  checkoutSessions  CheckoutSession[]
  historyStats      CustomerHistoryStats?
  interventions     Intervention[]
  invoices          Invoice[]
  revenueRiskEvents RevenueRiskEvent[]
  transactions      Transaction[]
}

model CustomerHistoryStats {
  id                      String   @id @default(cuid())
  customerId              String   @unique
  totalPayments           Int      @default(0)
  successfulPayments      Int      @default(0)
  failedPayments          Int      @default(0)
  previousAbandonments    Int      @default(0)
  previousRecoveries      Int      @default(0)
  avgReminderResponseDays Float?
  recoveryPropensityScore Float?
  updatedAt               DateTime @updatedAt
  customer                Customer @relation(fields: [customerId], references: [id])
}

model Transaction {
  id                String   @id @default(cuid())
  customerId        String
  amount            Float
  status            String
  paymentMethod     String?
  type              String
  failureReasonCode String?
  createdAt         DateTime @default(now())
  customer          Customer @relation(fields: [customerId], references: [id])
}

model CheckoutSession {
  id                String   @id @default(cuid())
  customerId        String
  cartValue         Float
  timeOnCheckoutSec Int?
  abandoned         Boolean  @default(false)
  createdAt         DateTime @default(now())
  customer          Customer @relation(fields: [customerId], references: [id])
}

model Invoice {
  id            String   @id @default(cuid())
  customerId    String
  amount        Float
  dueDate       DateTime
  status        String
  lateFeeAmount Float?
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id])
}

model RevenueRiskEvent {
  id            String             @id @default(cuid())
  sourceType    String
  sourceId      String
  customerId    String
  amountAtRisk  Float
  detectedAt    DateTime           @default(now())
  interventions Intervention[]
  customer      Customer           @relation(fields: [customerId], references: [id])
  rootCause     RootCauseAnalysis?
}

model RootCauseAnalysis {
  id                  String           @id @default(cuid())
  revenueRiskEventId  String           @unique
  predictedReason     String
  confidence          Float
  purchaseIntentScore Float
  signalsUsed         Json?
  createdAt           DateTime         @default(now())
  revenueRiskEvent    RevenueRiskEvent @relation(fields: [revenueRiskEventId], references: [id])
}

model Intervention {
  id                          String           @id @default(cuid())
  revenueRiskEventId          String
  customerId                  String
  actionType                  String
  cost                        Float
  expectedRecoveryProbability Float
  expectedRecoveredRevenue    Float
  messageText                 String?
  channel                     String?
  language                    String?
  status                      String           @default("pending")
  createdAt                   DateTime         @default(now())
  outcomeStatus               String           @default("pending") // "pending" | "recovered" | "not_recovered"
  actualRecoveredAmount       Float?
  outcomeRecordedAt           DateTime?
  customer                    Customer         @relation(fields: [customerId], references: [id])
  revenueRiskEvent            RevenueRiskEvent @relation(fields: [revenueRiskEventId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actor      String
  details    Json?
  timestamp  DateTime @default(now())
}

model PolicyRule {
  id          String  @id @default(cuid())
  ruleName    String  @unique
  maxValue    Float
  description String?
}

model BudgetAllocation {
  id             String   @id @default(cuid())
  periodStart    DateTime
  periodEnd      DateTime
  totalBudget    Float
  allocatedSoFar Float    @default(0)
}

model ActionPerformanceStats {
  id                 String   @id @default(cuid())
  actionType         String   @unique
  observedSuccessRate Float
  sampleSize         Int
  updatedAt          DateTime @updatedAt
}
