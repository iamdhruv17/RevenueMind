# PostgreSQL connection string — replace with your Neon/PostgreSQL URL
DATABASE_URL="postgresql://user:password@localhost:5432/revenuemind?sslmode=prefer"

# Neon direct/unpooled connection, required by schema.prisma
DIRECT_URL="postgresql://user:password@localhost:5432/revenuemind?sslmode=prefer"

# Optional — falls back to template messages if unset
GEMINI_API_KEY="your-gemini-api-key-here"
